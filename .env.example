# Personal access token. Classic: scope "repo". Fine-grained: read access to
# Actions, Administration, Contents, Issues, Metadata and Pull requests.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: a classic token with the public_repo scope. Only used to read the
# stargazer dates, which fine-grained tokens are not allowed to do. Without it
# the star curve starts at the first collection instead of reaching back.
GITHUB_TOKEN_STARS=

# The account whose repositories are collected.
GITHUB_LOGIN=sphings79

# There is no login to configure here: the dashboard asks for a user name and
# a password on the first visit, and keeps them in its database afterwards.

# Optional
PORT=8377
FULL_RUN_HOUR=4
QUICK_RUN_MINUTES=60
TZ=Europe/Berlin
