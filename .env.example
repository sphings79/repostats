# Personal access token. Classic: scope "repo". Fine-grained: read access to
# Actions, Administration, Contents, Issues, Metadata and Pull requests.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: a classic token with no scopes ticked. Only used to read the
# stargazer dates, which fine-grained tokens are not allowed to do. Without
# it the star curve starts at the first collection instead of reaching back.
GITHUB_TOKEN_STARS=

# The account whose repositories are collected.
GITHUB_LOGIN=sphings79

# Login for the dashboard itself. Leave the password empty and anyone who can
# reach the port is in — which is a bad idea, since private repositories are
# listed here.
AUTH_USER=admin
AUTH_PASSWORD=

# Optional
PORT=8377
FULL_RUN_HOUR=4
QUICK_RUN_MINUTES=60
TZ=Europe/Berlin
